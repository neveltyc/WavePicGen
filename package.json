{
  "name": "wavepicgen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WavePicGen — an academic/manual-quality digital timing (waveform) diagram editor",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "snapshot": "tsx scripts/snapshot.ts",
    "cli": "tsx src/cli.ts",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli/wavepicgen.mjs --banner:js=\"#!/usr/bin/env node\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "bin": {
    "wavepicgen": "dist/cli/wavepicgen.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "json5": "^2.2.3"
  }
}
